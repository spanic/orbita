@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Orbita Market — C4 Диаграмма контекста (Уровень 1)

' ─── Акторы ───────────────────────────────────────────────────────────────────

Person(operator, "Оператор ДЗЗ", "Заказывает спутниковые снимки, отслеживает статус заказов.")

Person(analyst, "Аналитическая компания", "Пополняет баланс геокредитов и управляет аккаунтом.")

' ─── Основная система ─────────────────────────────────────────────────────────

System(orbita, "Orbita Market", "B2B-платформа заказа спутниковых снимков и оплаты заказов внутренней валютой — геокредитами.")

' ─── Внешние системы (запланированы) ─────────────────────────────────────────

System_Ext(auth, "Провайдер аутентификации\n(запланировано)", "JWT-аутентификация пользователей.")

System_Ext(satellite, "Спутниковая система ДЗЗ\n(запланировано)", "Внешний оператор спутниковой съёмки. Получает задания на плановую и архивную съёмку.")

System_Ext(billing, "Платёжный шлюз\n(запланировано)", "Обработка пополнения баланса в фиатной валюте.")

' ─── Связи ────────────────────────────────────────────────────────────────────

Rel(operator, orbita, "Создает и получает информацию о статусах заказов", "HTTP / REST")
Rel(analyst, orbita, "Управляет аккаунтом, пополняет баланс", "HTTP / REST")

Rel(orbita, auth, "Аутентифицирует пользователей\n[этап 7 дорожной карты]", "HTTPS")
Rel(orbita, satellite, "Передаёт задания на съёмку\n[будущая интеграция]", "API")
Rel(orbita, billing, "Инициирует пополнение баланса\n[будущая интеграция]", "HTTPS")
@enduml